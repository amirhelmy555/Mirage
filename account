import streamlit as st
import pandas as pd
from datetime import datetime

# ضبط إعدادات الصفحة
st.set_page_config(page_title="برنامج المحاسبة - الإيرادات والمصروفات", page_icon="💰", layout="wide")

st.title("💼 برنامج إدارة الإيرادات والمصروفات والعمليات")

# قاعدة بيانات الموظفين (أكواد وأسماء)
if "employees" not in st.session_state:
    st.session_state.employees = {
        "101": "أحمد محمود",
        "102": "محمد علي",
        "103": "محمود حسن"
    }

# قاعدة بيانات الحركات (تخزين في جلسة العمل)
if "transactions" not in st.session_state:
    st.session_state.transactions = pd.DataFrame(
        columns=["التاريخ", "كود الموظف", "اسم الموظف", "النوع", "التصنيف", "المبلغ", "البيان / ملاحظات"]
    )

# الشريط الجانبي لإدارة الموظفين
with st.sidebar:
    st.header("👥 إدارة الموظفين والأكواد")
    
    # إضافة موظف جديد
    new_code = st.text_input("كود موظف جديد:")
    new_name = st.text_input("اسم الموظف:")
    if st.button("إضافة / تحديث موظف"):
        if new_code and new_name:
            st.session_state.employees[new_code] = new_name
            st.success(f"تمت إضافة الموظف: {new_name}")
        else:
            st.warning("يرجى إدخال الكود والاسم.")

    st.subheader("قائمة الموظفين")
    emp_df = pd.DataFrame(list(st.session_state.employees.items()), columns=["الكود", "الاسم"])
    st.dataframe(emp_df, use_container_width=True, hide_index=True)

# التبويبات الرئيسية للبرنامج
tab_add, tab_reports, tab_summary = st.tabs(["➕ تسجيل حركة جديدة", "📋 سجل الحركات والتصفية", "📊 الملخص والتقارير المالية"])

# --- التبويب الأول: تسجيل حركة جديدة ---
with tab_add:
    st.subheader("إدخال إيراد أو مصروف")
    
    col1, col2 = st.columns(2)
    
    with col1:
        emp_code_input = st.text_input("كود الموظف المسؤول عن العملية:")
        emp_name_found = st.session_state.employees.get(emp_code_input, "")
        
        if emp_code_input:
            if emp_name_found:
                st.info(f"الموظف المحدد: **{emp_name_found}**")
            else:
                st.error("❌ كود الموظف غير موجود بالنظام!")

        trans_type = st.radio("نوع العملية:", ["إيراد", "مصروف"], horizontal=True)

    with col2:
        if trans_type == "إيراد":
            category = st.selectbox("تصنيف الإيراد:", ["مبيعات services / صيانة", "دفعة عميل", "إيرادات أخرى"])
        else:
            category = st.selectbox("تصنيف المصروف:", ["قطع غيار / مستلزمات", "رواتب ومكافآت", "نثريات وتشغيل", "صيانة ومرافق", "مصروفات أخرى"])

        amount = st.number_input("المبلغ (بالجنيه/العملة):", min_value=0.0, step=50.0)
        notes = st.text_area("تفاصيل / بيان العملية:")

    if st.button("💾 حفظ العملية", use_container_width=True):
        if not emp_code_input or not emp_name_found:
            st.warning("يرجى إدخال كود موظف صحيح أولاً.")
        elif amount <= 0:
            st.warning("يرجى كتابة مبلغ أكبر من الصفر.")
        else:
            new_row = {
                "التاريخ": datetime.now().strftime("%Y-%m-%d %H:%M"),
                "كود الموظف": emp_code_input,
                "اسم الموظف": emp_name_found,
                "النوع": trans_type,
                "التصنيف": category,
                "المبلغ": amount,
                "البيان / ملاحظات": notes
            }
            st.session_state.transactions = pd.concat(
                [st.session_state.transactions, pd.DataFrame([new_row])],
                ignore_index=True
            )
            st.success("✅ تم حفظ العملية بنجاح!")

# --- التبويب الثاني: سجل الحركات والتصفية ---
with tab_reports:
    st.subheader("🔍 استعراض وتصفية العمليات")
    
    df = st.session_state.transactions
    
    if not df.empty:
        col_f1, col_f2 = st.columns(2)
        with col_f1:
            filter_emp = st.selectbox("تصفية حسب الموظف:", ["الكل"] + list(st.session_state.employees.keys()))
        with col_f2:
            filter_type = st.selectbox("تصفية حسب نوع العملية:", ["الكل", "إيراد", "مصروف"])

        filtered_df = df.copy()
        if filter_emp != "الكل":
            filtered_df = filtered_df[filtered_df["كود الموظف"] == filter_emp]
        if filter_type != "الكل":
            filtered_df = filtered_df[filtered_df["النوع"] == filter_type]

        st.dataframe(filtered_df, use_container_width=True, hide_index=True)
        
        # تصدير البيانات كـ CSV
        csv = filtered_df.to_csv(index=False).encode('utf-8-sig')
        st.download_button(
            label="📥 تحميل التقرير (CSV / Excel)",
            data=csv,
            file_name="financial_report.csv",
            mime="text/csv"
        )
    else:
        st.info("لا توجد أي حركات مسجلة حتى الآن.")

# --- التبويب الثالث: الملخص المالي ---
with tab_summary:
    st.subheader("📈 الإحصائيات والأرقام المالية")
    
    df = st.session_state.transactions
    
    if not df.empty:
        total_income = df[df["النوع"] == "إيراد"]["المبلغ"].sum()
        total_expense = df[df["النوع"] == "مصروف"]["المبلغ"].sum()
        net_profit = total_income - total_expense
        
        m1, m2, m3 = st.columns(3)
        m1.metric("إجمالي الإيرادات", f"{total_income:,.2f}")
        m2.metric("إجمالي المصروفات", f"{total_expense:,.2f}")
        m3.metric("صافي الأرباح / الخزينة", f"{net_profit:,.2f}", delta=f"{net_profit:,.2f}")
        
        st.divider()
        st.subheader("📊 توزيع المصروفات حسب التصنيف")
        expense_df = df[df["النوع"] == "مصروف"]
        if not expense_df.empty:
            cat_summary = expense_df.groupby("التصنيف")["المبلغ"].sum()
            st.bar_chart(cat_summary)
    else:
        st.info("قم بإضافة حركات مالية لعرض الإحصائيات.")
